{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-BACKEND.up.railway.app/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://YOUR-BACKEND.up.railway.app/media/:path*"
    },
    {
      "source": "/((?!api/|media/).*)",
      "destination": "/index.html"
    }
  ]
}
