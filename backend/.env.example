# Локальная разработка: DEBUG=True
# Production (Railway): DEBUG=False и уникальный SECRET_KEY обязательны
SECRET_KEY=django-insecure-замени-на-свой-ключ
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=freelancer_arm
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Google SMTP (нужен App Password: Google Account → Безопасность → 2FA → Пароли приложений)
EMAIL_HOST_USER=freelancerarm@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
DEFAULT_FROM_EMAIL=Freelancer ARM <freelancerarm@gmail.com>
FRONTEND_URL=http://localhost:5173

# Production (Railway), через запятую:
# ALLOWED_HOSTS=your-app.up.railway.app
# FRONTEND_URL=https://your-app.vercel.app
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
